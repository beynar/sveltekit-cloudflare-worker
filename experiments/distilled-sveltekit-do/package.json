{
	"name": "distilled-sveltekit-do",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"build": "bun scripts/build.ts",
		"dev": "bun scripts/dev.ts",
		"probe": "bun scripts/probe.ts",
		"dry-run": "pnpm build && wrangler deploy --dry-run --outdir .wrangler-dry-run",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
	},
	"dependencies": {
		"@distilled.cloud/cloudflare": "0.30.3",
		"@distilled.cloud/cloudflare-runtime": "0.17.1",
		"@distilled.cloud/sveltekit": "0.17.1",
		"@effect/platform-node": "4.0.0-beta.102",
		"effect": "4.0.0-beta.102"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "5.20260812.1",
		"@distilled.cloud/cloudflare-vite-plugin": "0.17.1",
		"@sveltejs/kit": "3.0.0-next.13",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@types/node": "26.1.2",
		"esbuild": "0.28.1",
		"svelte": "5.56.8",
		"svelte-check": "4.7.4",
		"typescript": "6.0.3",
		"vite": "8.2.0",
		"wrangler": "4.118.0"
	}
}
