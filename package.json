{
	"name": "sveltekit-cloudflare-worker",
	"version": "0.1.0",
	"description": "Put a src/worker.ts Cloudflare Worker (fetch middleware, Durable Objects, queues, cron, Workflows) in front of SvelteKit 3: in vite dev with workerd and HMR, and in the adapter-cloudflare build.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/beynar/sveltekit-cloudflare-worker.git"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite build && wrangler dev",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest --config vitest.config.ts",
		"test:integration": "vitest --config vitest.integration.config.ts --run",
		"test": "npm run test:unit -- --run",
		"prepack": "publint"
	},
	"files": [
		"src/lib/**/*.js",
		"src/lib/**/*.d.ts",
		"!src/lib/**/*.test.*",
		"!src/lib/demo*"
	],
	"types": "./src/lib/index.d.ts",
	"imports": {
		"#lib": "./src/lib",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./src/lib/index.d.ts",
			"import": "./src/lib/index.js",
			"default": "./src/lib/index.js"
		},
		"./package.json": "./package.json"
	},
	"dependencies": {
		"@cloudflare/workers-types": "^5.20260823.1",
		"acorn": "^8.18.0",
		"esbuild": "^0.28.2",
		"ws": "^8.21.0"
	},
	"peerDependencies": {
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.1.0",
		"vite": "^8.0.12",
		"wrangler": "^4.125.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.1",
		"@types/node": "^26.0.0",
		"@types/ws": "^8.18.2",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.7.0",
		"hono": "^4.12.27",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"publint": "^0.3.21",
		"sugar-high": "^1.2.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.0",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.0",
		"vite": "^8.1.0",
		"vitest": "^4.1.9",
		"wrangler": "^4.125.0"
	},
	"engines": {
		"node": ">=20.19"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"cloudflare",
		"workers",
		"durable-objects",
		"vite"
	]
}
